# Copy to .env.local and fill in. Never commit real secrets.

# Vercel Postgres (Neon) — from the Vercel dashboard "Storage" tab
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Auth (NextAuth / Auth.js)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI provider (Gemma / OpenAI-compatible) for triage, recommendation, summaries
AI_API_KEY=
AI_BASE_URL=

# Video (Daily.co) — or use Jitsi (no key needed)
DAILY_API_KEY=

# Email (Resend) for reminders
RESEND_API_KEY=
