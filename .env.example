# Copy to .env.local and fill in. Never commit real secrets.

# Vercel Postgres (Neon) — from the Vercel dashboard "Storage" tab
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Auth. Sessions are random opaque tokens in an HttpOnly cookie (lib/auth.js);
# the only setting is the staff invite code needed to create an admin account.
NIRAMOY_ADMIN_CODE=NIRAMOY-ADMIN

# AI provider (Gemma / OpenAI-compatible) for triage, recommendation, summaries
AI_API_KEY=
AI_BASE_URL=

# Video (Daily.co) — or use Jitsi (no key needed)
DAILY_API_KEY=

# Email (Resend) for reminders
RESEND_API_KEY=

# BM&DC verification (optional).
# Only set this if you have a real data-sharing endpoint or institutional proxy.
# When unset, doctor applications route to the admin verification queue for a
# human to confirm at https://verify.bmdc.org.bd/ — it never auto-approves.
BMDC_API_URL=

# Model name for the AI layer (defaults to gpt-4o-mini)
AI_MODEL=
