# Niramoy — environment configuration
#
# Copy to .env.local and fill in what you need. NOTHING here is required to run
# the app: with an empty file you get an in-process PGlite database, the
# deterministic AI rule engine, a demo video provider, a mock payment provider,
# and email printed to the console. That is deliberate — the project must be
# reviewable without provisioning infrastructure.
#
# Production is different: APP_ENV=production makes DATABASE_URL, SESSION_SECRET,
# NIRAMOY_ADMIN_CODE and CRON_SECRET mandatory, and refuses to boot without them.
#
# NEVER COMMIT A FILLED-IN COPY OF THIS FILE.

# ---- Application -----------------------------------------------------------
APP_ENV=development            # development | test | production
APP_URL=http://localhost:3000
LOG_LEVEL=info                 # debug | info | warn | error

# ---- Database --------------------------------------------------------------
# Unset => in-process PGlite (development only; production refuses it).
# The POSTGRES_* names from a Vercel Postgres integration are also accepted.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=      # non-pooled; used for migrations
# DATABASE_DRIVER=             # neon | pg | pglite — inferred if unset

# Real PostgreSQL for the concurrency test suite (see docker-compose.yml).
DATABASE_URL_TEST=

# ---- Auth ------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Staff invite code required to create an admin account.
NIRAMOY_ADMIN_CODE=

# ---- AI --------------------------------------------------------------------
# Unset => the deterministic rule engine only, and NO patient text leaves the
# system. Setting a key enables the LLM layer; the rule engine still runs first
# and emergency red flags are never sent to a model. See docs/AI_SAFETY.md.
AI_PROVIDER=                   # rules | openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- Email -----------------------------------------------------------------
EMAIL_PROVIDER=                # console | resend
EMAIL_API_KEY=
EMAIL_FROM=

# ---- Video -----------------------------------------------------------------
# Keys are server-side only and are never sent to the browser. Rooms are created
# and join tokens minted server-side, scoped to the two appointment participants.
VIDEO_PROVIDER=                # demo | daily | jitsi
VIDEO_API_KEY=
VIDEO_API_SECRET=
VIDEO_DOMAIN=

# ---- Payments --------------------------------------------------------------
# Defaults to a clearly-labelled mock. Nothing is charged and the UI says so.
PAYMENT_PROVIDER=              # mock | bkash | nagad
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- BM&DC verification ----------------------------------------------------
# Only set this if you hold a real data-sharing endpoint or institutional proxy.
# When unset, doctor applications route to the admin queue for a human to
# confirm at https://verify.bmdc.org.bd/. It never auto-approves, and it never
# fails open. Niramoy does not scrape the register or defeat its captcha.
BMDC_API_URL=

# ---- Rate limiting ---------------------------------------------------------
# Unset => durable Postgres-backed counters (correct, no extra infrastructure).
# Set to an Upstash Redis REST URL to use Redis instead.
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=

# ---- Cron ------------------------------------------------------------------
# Shared secret the scheduler presents to /api/cron/*. At least 32 characters.
CRON_SECRET=

# ---- Locale / clinical -----------------------------------------------------
DISPLAY_TIMEZONE=Asia/Dhaka    # IANA zone, never a fixed offset
EMERGENCY_NUMBER=999
# Synthetic seed profiles. Defaults to true outside production, false in it.
ALLOW_DEMO_PROFILES=
