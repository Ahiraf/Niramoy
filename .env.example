# Niramoy — environment configuration
#
# Copy to .env.local and fill in what you need. NOTHING here is required to run
# the app: with an empty file you get an in-process PGlite database, the
# deterministic AI rule engine, a demo video provider, a mock payment provider,
# and email printed to the console. That is deliberate — the project must be
# reviewable without provisioning infrastructure.
#
# Production is different: APP_ENV=production makes DATABASE_URL, SESSION_SECRET,
# NIRAMOY_ADMIN_CODE and CRON_SECRET mandatory, and refuses to boot without them.
#
# NEVER COMMIT A FILLED-IN COPY OF THIS FILE.

# ---- Application -----------------------------------------------------------
APP_ENV=development            # development | test | production
APP_URL=http://localhost:3000
LOG_LEVEL=info                 # debug | info | warn | error

# ---- Database --------------------------------------------------------------
# Unset => in-process PGlite (development only; production refuses it).
# The POSTGRES_* names from a Vercel Postgres integration are also accepted.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=      # non-pooled; used for migrations
# DATABASE_DRIVER=             # neon | pg | pglite — inferred if unset

# Real PostgreSQL for the concurrency test suite (see docker-compose.yml).
DATABASE_URL_TEST=

# ---- Auth ------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Staff invite code required to create an admin account.
NIRAMOY_ADMIN_CODE=

# ---- AI --------------------------------------------------------------------
# Unset => the deterministic rule engine only, and NO patient text leaves the
# system. Setting a key enables the LLM layer; the rule engine still runs first
# and emergency red flags are never sent to a model. See docs/AI_SAFETY.md.
#
# Any provider that speaks the OpenAI /chat/completions protocol works; there is
# no vendor SDK to install. Gemini is the practical choice for a free key — AI
# Studio issues one with a Google account and no card, and Google publishes an
# OpenAI-compatible endpoint.
#
# Keys are tried IN ORDER and the first that answers serves the request:
#
#     GEMINI_API_KEY_1  →  GEMINI_API_KEY_2  →  GEMINI_API_KEY_3  →  OPENAI_API_KEY
#
# Three Gemini keys because a free-tier quota is per key and per day: when one
# is spent the next takes over instead of the assistant going quiet. OpenAI is
# last because it is the one that costs money — it should be reached only once
# the free keys are genuinely exhausted. Configure as many or as few as you
# like; unset ones are skipped.
#
# A key is passed over when it reports a limit (429), is rejected, or cannot be
# reached. When ALL of them fail, triage keeps its deterministic rule-based
# answer and the visit summary stays undrafted — it never fails open.
#
# Run `npm run ai:check` after setting these. It probes every key separately,
# which matters here: with a chain, a dead key is invisible until it is the
# last one left.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=                  # default gemini-2.5-flash; check ids in AI Studio
GEMINI_BASE_URL=               # default https://generativelanguage.googleapis.com/v1beta/openai

OPENAI_API_KEY=
OPENAI_MODEL=                  # default gpt-4o-mini
OPENAI_BASE_URL=               # default https://api.openai.com/v1

# A single custom endpoint, from before the chain existed. Still supported, and
# tried last. Leave blank unless you are pointing at your own gateway.
AI_PROVIDER=                   # rules | openai-compatible
AI_API_KEY=
AI_BASE_URL=                   # no trailing slash; /chat/completions is appended
AI_MODEL=

# ---- Email -----------------------------------------------------------------
EMAIL_PROVIDER=                # console | resend
EMAIL_API_KEY=
EMAIL_FROM=

# ---- SMS -------------------------------------------------------------------
# Used for the sign-up code that proves a mobile number, and — once a number is
# proved — for appointment reminders on the SMS channel.
#
# Unset => the code is printed to the server log instead of sent, and the API
# says so (`delivered: false`) rather than implying a message is on its way. A
# sign-up can still be completed that way, which is what keeps the project
# reviewable without a gateway account.
#
# TextBee turns an Android handset into the gateway: install their app, scan the
# pairing code, and messages post through that phone's own SIM. That is the
# practical route in Bangladesh — an operator A2P route needs a registered
# company and a masking approval, and patients here expect a code from an
# ordinary 01XXXXXXXXX number anyway. The handset must be powered, on the
# network, and holding credit.
#
# TEXTBEE_DEVICE_ID is optional and only matters with more than one paired
# handset; without it TextBee picks one for you.
SMS_PROVIDER=                  # console | textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=              # defaults to https://api.textbee.dev/api/v1

# ---- Video -----------------------------------------------------------------
# Keys are server-side only and are never sent to the browser. Rooms are created
# and join tokens minted server-side, scoped to the two appointment participants.
#
# VIDEO_PROVIDER=jitsi with NO key or secret uses a public meet.jit.si room:
# real two-way video with no vendor account, which is what makes a live
# consultation demonstrable. The room name is random and only the two
# participants are ever given it, but the public service is not token-gated —
# so production refuses this combination and requires the JWT credentials.
VIDEO_PROVIDER=                # demo | daily | jitsi
VIDEO_API_KEY=
VIDEO_API_SECRET=
VIDEO_DOMAIN=                  # defaults to meet.jit.si for jitsi
# Required to run the credential-free public room under APP_ENV=production —
# a deployed demonstration on two devices. Off by default, and deliberately
# awkward to switch on: the room is unlisted, not access-controlled.
ALLOW_PUBLIC_VIDEO_ROOM=       # true | false (default false)

# ---- Payments --------------------------------------------------------------
# Defaults to a clearly-labelled mock. Nothing is charged and the UI says so.
PAYMENT_PROVIDER=              # mock | bkash | nagad
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- BM&DC verification ----------------------------------------------------
# Only set this if you hold a real data-sharing endpoint or institutional proxy.
# When unset, doctor applications route to the admin queue for a human to
# confirm at https://verify.bmdc.org.bd/. It never auto-approves, and it never
# fails open. Niramoy does not scrape the register or defeat its captcha.
BMDC_API_URL=

# ---- Rate limiting ---------------------------------------------------------
# Unset => durable Postgres-backed counters (correct, no extra infrastructure).
# Set to an Upstash Redis REST URL to use Redis instead.
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=

# ---- Cron ------------------------------------------------------------------
# Shared secret the scheduler presents to /api/cron/*. At least 32 characters.
CRON_SECRET=

# ---- Locale / clinical -----------------------------------------------------
DISPLAY_TIMEZONE=Asia/Dhaka    # IANA zone, never a fixed offset
EMERGENCY_NUMBER=999
# Synthetic seed profiles. Defaults to true outside production, false in it.
ALLOW_DEMO_PROFILES=
