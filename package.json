{
  "name": "niramoy",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted serverless telemedicine & appointment platform (CSE-356)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:concurrency": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch=\"**/__tests__/**/*.concurrency.test.[jt]s\" --testPathIgnorePatterns=/node_modules/ --runInBand",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.6",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "jest": "^29.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
